    <bpmn2:task id="_13D6360F-BA72-42DF-B1AE-D1270CCA6BE6" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Creacion de registro de tracking">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Creacion de registro de tracking]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[//Creacion de objeto para registro tracking
System.out.println("---Creacion de objeto para registro tracking");
java.util.ArrayList<co.com.soaint.bpm.model.domains.TrackDTO> trackList = new java.util.ArrayList<co.com.soaint.bpm.model.domains.TrackDTO>();
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();

track.setObjectType("Documento");
String accionArchivo = (String) kcontext.getVariable("accion")!=null ? kcontext.getVariable("accion").toString() : "";
      
if(kcontext.getVariable("nomuser")!=null){
  track.setUser(kcontext.getVariable("nomuser").toString());
}
if("informado".equals(accionArchivo) && kcontext.getVariable("numeroRadicado")!=null){
  System.out.println("---marcado como informado "+ kcontext.getVariable("numeroRadicado").toString());
  track.setTrackStateId(96);
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
}

else if(kcontext.getVariable("numeroRadicado")!=null){
  System.out.println("---La tarea esta conectada con el radicado "+ kcontext.getVariable("numeroRadicado").toString());
  track.setTrackStateId(34);
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
} else {
  System.out.println("---La tarea es por demanda");
  track.setTrackStateId(33);
}
      
track.setSubsection(Long.parseLong(kcontext.getVariable("codDependencia").toString()));
track.setInstanceId(kcontext.getProcessInstance().getId());
          
trackList.add(track);

kcontext.setVariable("trackDTOList",trackList);
System.out.println("---Fin de objeto para registro tracking");
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>

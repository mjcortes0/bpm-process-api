    <bpmn2:scriptTask id="_9BEDFA20-A8F1-4930-842A-8BD6C48B4EA6" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Script Task 3" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script Task 3]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_06C83465-C104-4E63-8171-1CA5752D3EBB</bpmn2:incoming>
      <bpmn2:outgoing>_9B9CEA5F-FB17-46C4-8EAD-351525990ABC</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("-----------------------------------------------"+kcontext.getVariable("datosRecibidos"));

java.util.Map<String, Object> map = (java.util.HashMap) kcontext.getVariable("datosRecibidos");

kcontext.setVariable("codDependencia", map.get("codDependencia").toString());
kcontext.setVariable("numeroRadicado", map.get("numeroRadicado").toString());
kcontext.setVariable("usuarioSolicitante", map.get("usuarioProyectorRadicador").toString());

if(map.containsKey("asuntoTarea")){
	kcontext.setVariable("asuntoTarea",(map.get("asuntoTarea") != null) ? map.get("asuntoTarea").toString() : null);
}
if(map.containsKey("userAsignador")){
	kcontext.setVariable("userAsignador",(map.get("userAsignador") != null) ? map.get("userAsignador").toString() : null);
}
if(map.containsKey("depAsignador")){
	kcontext.setVariable("depAsignador",(map.get("depAsignador") != null) ? map.get("depAsignador").toString() : null);
}

if(map.get("numeroRadicadoPrincipal")!=null){
  kcontext.setVariable("numeroRadicadoPrincipal", map.get("numeroRadicadoPrincipal").toString());
}

System.out.println("-----------------------------------------------"+map.get("codDependencia").toString());]]></bpmn2:script>
    </bpmn2:scriptTask>

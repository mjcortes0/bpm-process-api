    <bpmn2:userTask id="_CF6277AA-0E81-4522-AB56-28FC6244560E" drools:selectable="true" drools:scriptFormat="http://www.java.com/java" color:background-color="#00CCFF" color:border-color="#000000" color:color="#000000" name="Firmar Documento">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Firmar Documento]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[//Asignar Firma
ArrayList<String> list=(ArrayList) kcontext.getVariable("listaAprobador");
kcontext.setVariable("usuarioAprobador", list.get((int) kcontext.getVariable("indice")));
String usuarioDependencia = list.get((int) kcontext.getVariable("indice"));
String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];
kcontext.setVariable("usuarioAprobador", usuario);
kcontext.setVariable("codDependencia", dependencia );
kcontext.setVariable("userAsignador", usuario);
kcontext.setVariable("nameTaskMassiveActive", "Firmar Documento");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[//Actualizar Lista Aprobadores
ArrayList<String> listA= (ArrayList) kcontext.getVariable("listaAprobador");
kcontext.setVariable("cantidadA", listA.size());  

System.out.println("[lista de aprobador]"+listaAprobador);
//Incrementar indice
kcontext.setVariable("indice", (int) kcontext.getVariable("indice") + 1);  

ArrayList<String> listB= (ArrayList) kcontext.getVariable("listaAprobador");
kcontext.setVariable("cantidadA", listB.size());  
kcontext.setVariable("nameTaskMassiveActive", "");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

    <bpmn2:task id="_A2338794-630A-4DC0-B8F9-69FEEEE654E3" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Notificacion Electronica">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Notificacion Electronica]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Start at " +
                java.time
                        .LocalDateTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Notificacion Electronica");
//Script Task Correo
System.out.println("[Iniciando Script de variables para alerta alectronica produccion documental]");
java.util.Map <String, Object> params2 = new java.util.HashMap<>();
        params2.put("numeroRadicado", kcontext.getVariable("numeroRadicado"));
        params2.put("asunto", kcontext.getVariable("asunto")); 
        params2.put("listaProyector", kcontext.getVariable("listaProyector")); 
        params2.put("listaRevisor", kcontext.getVariable("listaRevisor"));
        params2.put("listaAprobador", kcontext.getVariable("listaAprobador"));
        params2.put("Term", "");
        
        if(kcontext.getVariable("tipoProduccion") != null && kcontext.getVariable("tipoProduccion").equals("resolucion")){
          params2.put("notificar", "false");
        }

co.com.soaint.bpm.model.domains.MailDTO request = new co.com.soaint.bpm.model.domains.MailDTO();
  request.setParams(params2);
kcontext.setVariable("mailDTO",  request);
System.out.println("[Terminando Script de variables para alerta alectronica produccion documental]");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[LOG ENVIO CORREO ELECTRONICO-----------------------"+ kcontext.getVariable("respuestaSennal"));
System.out.println("Ends " +
                java.time
                        .LocalDateTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Notificacion Electronica");
//Iniciar Variables
kcontext.setVariable("codDependencia", kcontext.getVariable("dependenciaSalida"));
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

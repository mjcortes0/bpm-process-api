    <bpmn2:task id="_AE824BDB-055B-4C1A-AFAD-4FEBCDAAD41C" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Actualizar resoluciones">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Actualizar resoluciones]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Start at " +
                java.time
                        .LocalDateTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Actualizar instancia firma en resoluciones");
//Creacion de objeto para registro tracking
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();

track.setObjectId(kcontext.getVariable("instanciaProduccion").toString());
track.setInstanceId(kcontext.getProcessInstance().getId());

kcontext.setVariable("trackDTO",track);
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>

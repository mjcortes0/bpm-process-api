    <bpmn2:userTask id="_9FC21E1D-049E-4811-85F0-D7B481FC5CFA" drools:selectable="true" drools:scriptFormat="http://www.java.com/java" color:background-color="#00CCFF" color:border-color="#000000" color:color="#000000" name="Revisar Progreso Comunicaciones Masivas">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Revisar Progreso Comunicaciones Masivas]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[ArrayList<String> list=(ArrayList) kcontext.getVariable("listaProyector");
String usuarioDependencia = list.get(0);
String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];
kcontext.setVariable("usuarioProyector", usuario);
kcontext.setVariable("codDependencia", dependencia);
kcontext.setVariable("nameTaskMassiveActive", "Revisar progreso comunicaciones masivas");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[kcontext.setVariable("nameTaskMassiveActive", "");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

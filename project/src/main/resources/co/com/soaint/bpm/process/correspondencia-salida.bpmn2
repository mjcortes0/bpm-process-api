    <bpmn2:userTask id="_48F2191C-512B-496F-BBAF-6FF63AB180C6" drools:selectable="true" drools:scriptFormat="http://www.java.com/java" color:background-color="#00CCFF" color:border-color="#000000" color:color="#000000" name="Radicar Documento Producido">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Radicar Documento Producido]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[//Iniciar Variable
java.util.LinkedHashMap map = (java.util.LinkedHashMap)kcontext.getVariable("datosRecibidos");

kcontext.setVariable("codDependencia", map.get("codDependencia").toString());
kcontext.setVariable("idInstancia", Long.parseLong(map.get("idProduccion").toString()));
kcontext.setVariable("usuarioProyectorRadicador", map.get("usuarioProyectorRadicador").toString());

if(map.containsKey("asuntoTarea")){
	kcontext.setVariable("asuntoTarea",(map.get("asuntoTarea") != null) ? map.get("asuntoTarea").toString() : null);
}
if(map.containsKey("userAsignador")){
	kcontext.setVariable("userAsignador",(map.get("userAsignador") != null) ? map.get("userAsignador").toString() : null);
}
if(map.containsKey("depAsignador")){
	kcontext.setVariable("depAsignador",(map.get("depAsignador") != null) ? map.get("depAsignador").toString() : null);
}

kcontext.setVariable("SignalProcessInstanceId", kcontext.getVariable("idInstancia"));
kcontext.setVariable("SignalDeploymentId", "co.com.soaint.sgd.process:proceso-produccion-documental:1.0.0-SNAPSHOT");
kcontext.setVariable("respuestaProduccion", 1);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[kcontext.setVariable("correspondenciaDTO",new co.com.soaint.bpm.model.domains.Correspondencia(numeroRadicado,"RT"));
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

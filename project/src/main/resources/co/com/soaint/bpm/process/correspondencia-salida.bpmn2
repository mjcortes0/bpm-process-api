    <bpmn2:task id="_9CAAC2D3-D51A-4DEF-B0CB-22EAAF6279A9" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Actualizar Estado Radicacion">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Actualizar Estado Radicacion]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println(" --- LOG ACTUALIZAR ESTADO RADICACION ---" . concat(correspondenciaDTO.toString()) );
//Inicializar correspondencia
System.out.println("LOG INICIARLIZAR CORRESPONDENCIA para Nro: ".concat(numeroRadicado) );
kcontext.setVariable("correspondenciaDTO",new co.com.soaint.bpm.model.domains.Correspondencia(numeroRadicado,"SA"));
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println(" --- ESTADO FINAL ACTUALIZAR CORRESPONDENCIA -----------------------> " . concat( estadoFinal ) );
//Script Task 5
System.out.println("[Iniciando Script de variables para organizacion y archivo]");
java.util.Map <String, Object> params2 = new java.util.HashMap<>();
        //params2.put("codDependencia", kcontext.getVariable("codDependencia"));
        params2.put("codDependencia", "1301");
        params2.put("numeroRadicado", kcontext.getVariable("numeroRadicado")); 

if(kcontext.getVariable("isFromMassive") != null){
  System.out.println("Es de produccion documental masiva :::::::: "+ kcontext.getVariable("isFromMassive"));
  params2.put("usuarioProyectorRadicador", kcontext.getVariable("userAsignador"));  
} else {
  System.out.println("No es de produccion documental masiva :::::::: "+ kcontext.getVariable("isFromMassive"));
  params2.put("usuarioProyectorRadicador", kcontext.getVariable("usuarioProyectorRadicador"));
}
       

System.out.println("asuntoTarea :::::::: "+ kcontext.getVariable("asuntoTarea"));
System.out.println("userAsignador ::::::::"+ kcontext.getVariable("userAsignador"));
System.out.println("depAsignador :::::::::"+ kcontext.getVariable("depAsignador"));

if(kcontext.getVariable("asuntoTarea") != null){
  params2.put("asuntoTarea", kcontext.getVariable("asuntoTarea"));
}
if(kcontext.getVariable("userAsignador") != null){
  params2.put("userAsignador", kcontext.getVariable("userAsignador"));
}
if(kcontext.getVariable("depAsignador") != null){
  params2.put("depAsignador", kcontext.getVariable("depAsignador"));
}

kcontext.setVariable("datosSennal",  params2);
System.out.println("[Terminando Script de variables para organizacion y archivo]+datosSennal");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

    <bpmn2:task id="_8DA09EB1-643F-41AF-B864-BB27DB42FD8E" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Creacion de registro de tracking">

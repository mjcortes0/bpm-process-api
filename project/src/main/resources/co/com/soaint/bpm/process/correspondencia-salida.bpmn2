    <bpmn2:task id="_27119F95-2AC4-4EAC-8DA5-DB88E9B69140" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Actualizar Estado Radicacion">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Actualizar Estado Radicacion]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println(" --- LOG ACTUALIZAR ESTADO RADICACION ---" . concat(correspondenciaDTO.toString()) );
//Obtener datos de la señal
System.out.println("Recibiendo datos señal");
java.util.LinkedHashMap map = (java.util.LinkedHashMap)kcontext.getVariable("respuestaSennal");

kcontext.setVariable("ideEcm", map.get("ideEcm").toString());
//Inicializar correspondencia
System.out.println("LOG INICIARLIZAR CORRESPONDENCIA para Nro: ".concat(numeroRadicado) );
//kcontext.setVariable("correspondenciaDTO",new co.com.soaint.bpm.model.domains.Correspondencia(numeroRadicado,"RG"));
String idEcmAux = (String) kcontext.getVariable("ideEcm");
kcontext.setVariable("correspondenciaDTO",new co.com.soaint.bpm.model.domains.Correspondencia(numeroRadicado,"RG",idEcmAux));
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println(" --- ESTADO FINAL ACTUALIZAR CORRESPONDENCIA -----------------------> " . concat( estadoFinal ) );
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

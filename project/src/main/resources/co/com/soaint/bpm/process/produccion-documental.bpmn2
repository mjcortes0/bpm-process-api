    <bpmn2:task id="_5D9EA7BF-FE44-4C0C-AD4F-FE8E46108CE7" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Creacion de registro de tracking">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Creacion de registro de tracking]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Start at " +
                java.time
                        .LocalTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Creacion de registro de tracking");
//Creacion de objeto para registro tracking
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();

if(kcontext.getVariable("numeroRadicado")!=null){
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
}else if(kcontext.getVariable("idEcmDocument")!= null){
    track.setObjectId(kcontext.getVariable("idEcmDocument").toString());
}

track.setObjectType("Documento");
if(kcontext.getVariable("nomuser")!=null){
  track.setUser(kcontext.getVariable("nomuser").toString());
}
track.setTrackStateId(22);
if(aprobado == 4){//"Aprobar y firmar documento"
	track.setTrackStateId(86);
}

if(kcontext.getVariable("codDependencia")!=null){
  track.setSubsection(Long.parseLong(kcontext.getVariable("codDependencia").toString()));
}
track.setInstanceId(kcontext.getProcessInstance().getId());

kcontext.setVariable("trackDTO",track);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Ends at " +
                java.time
                        .LocalTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Creacion de registro de tracking");

ArrayList<String> listA = (ArrayList<String>) kcontext.getVariable("listaAprobador");


int listA_cnt = (listA != null) ? listA.size() : 1;
kcontext.setVariable("cantidadA", listA_cnt);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

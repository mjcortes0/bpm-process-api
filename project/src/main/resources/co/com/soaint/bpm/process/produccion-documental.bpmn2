        <bpmn2:targetRef>_5ECBE20B-393E-42B3-97F6-1B2BAB167A60_OperationInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_JiWqmJmtEfCvarqHC1DP4Q">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="_JiWqmZmtEfCvarqHC1DP4Q"><![CDATA[crearTracking]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="_JiWqmpmtEfCvarqHC1DP4Q">_5ECBE20B-393E-42B3-97F6-1B2BAB167A60_OperationInputX</bpmn2:to>

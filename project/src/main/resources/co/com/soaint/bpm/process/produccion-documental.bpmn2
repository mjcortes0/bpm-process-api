    </bpmn2:startEvent>
    <bpmn2:scriptTask id="_0255146B-51F1-4579-96FB-DEC9FC6B6879" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Inicializar lista Proyectores" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inicializar lista Proyectores]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_65F53A84-6AE0-497A-81E8-6506F923E442</bpmn2:incoming>
      <bpmn2:outgoing>_3785CD1A-9AAB-4654-9B87-DFF302EA8B80</bpmn2:outgoing>
      <bpmn2:script><![CDATA[ArrayList<String> list= new ArrayList<String>();
String usuario = (String) kcontext.getVariable("usuarioProyector");
String dependencia = (String) kcontext.getVariable("codDependencia");
list.add(usuario.concat(":").concat(dependencia));
kcontext.setVariable("indice",0);
kcontext.setVariable("listaProyector", list);
kcontext.setVariable("nombreTareaProducir","Producir Documento");
kcontext.setVariable("aprobado", 0);

kcontext.setVariable("tipoDevolucionAplicada", "NONE");

]]></bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:scriptTask id="_D055546D-8DE6-4914-9E51-523A001D16D5" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Incrementar indice" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Incrementar indice]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_1FA57ED3-FB24-43E5-9B51-FECC2E624439</bpmn2:incoming>
      <bpmn2:outgoing>_33436ACF-382C-42A2-8488-80DC3B687CBF</bpmn2:outgoing>
      <bpmn2:script><![CDATA[//flujo de devolucion
Integer flagDevolucionAux = kcontext.getVariable("flagDevolucion") != null ? (Integer) kcontext.getVariable("flagDevolucion") : 0;
if(flagDevolucionAux == 1){  
  kcontext.setVariable("indice", (int) kcontext.getVariable("indice") - 1); 
}
else{
  kcontext.setVariable("indice", (int) kcontext.getVariable("indice") + 1); 
}


 
ArrayList<String> listR= (ArrayList) kcontext.getVariable("listaRevisor");
ArrayList<String> listA= (ArrayList) kcontext.getVariable("listaAprobador");
kcontext.setVariable("cantidadR", listR.size());  
kcontext.setVariable("cantidadA", listA.size());  



]]></bpmn2:script>
    </bpmn2:scriptTask>

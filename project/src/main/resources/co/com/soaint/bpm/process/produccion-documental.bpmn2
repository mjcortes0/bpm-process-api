    <bpmn2:scriptTask id="_689A4BE4-E0B6-4E78-A2FC-A3EF4A7708EE" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Asignar usuario proyector" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Asignar usuario proyector]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_C26F9C9C-1969-47CE-819B-CF8ED3E0ECCA</bpmn2:incoming>
      <bpmn2:outgoing>_801B512C-80A0-4D4B-BCAA-7BFB0B001D34</bpmn2:outgoing>
      <bpmn2:script><![CDATA[ArrayList<String> list=(ArrayList) kcontext.getVariable("listaProyector");
String usuarioDependencia = list.get((int) kcontext.getVariable("indice"));

String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];

kcontext.setVariable("usuarioProyector", usuario);
kcontext.setVariable("codDependencia", dependencia );

]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:startEvent id="_1E65BF8F-D268-4A76-91CC-2DAAE57A9991" drools:selectable="true" color:background-color="#9acd32" color:border-color="#000000" color:color="#000000" name="Iniciar">

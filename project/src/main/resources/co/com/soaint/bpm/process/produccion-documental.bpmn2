    <bpmn2:exclusiveGateway id="_FF41F3D2-7DAE-4F73-B547-F582FA030916" drools:selectable="true" drools:dg="_5D900258-8E53-4A1D-A302-31605231A2FF" color:background-color="#f0e68c" color:border-color="#a67f00" color:color="#000000" name="Validar cantidad de proyectores" gatewayDirection="Diverging" default="_5D900258-8E53-4A1D-A302-31605231A2FF">

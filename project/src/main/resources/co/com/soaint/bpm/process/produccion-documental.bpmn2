        <bpmn2:inputSet id="_3jLIL2mcEfC4fKjlGxcpbw">
          <bpmn2:dataInputRefs>_A5EA6310-A8BB-4E07-B856-D1CC932F9FB6_TermInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_A5EA6310-A8BB-4E07-B856-D1CC932F9FB6_ParameterInputX</bpmn2:dataInputRefs>

    <bpmn2:scriptTask id="_47A4CA05-E849-4D13-A179-C4980CF355F3" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Asignar Usuario Revisor" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Asignar Usuario Revisor]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_65FE7AB7-15D9-4122-A9AD-80376DEA7851</bpmn2:incoming>
      <bpmn2:outgoing>_F216BB47-B215-41B8-AD7B-8DCF6C69347E</bpmn2:outgoing>
      <bpmn2:script><![CDATA[//Bloque para validar si llegó desde la aprobación
if(aprobado == 0){
// Recuperar el objeto track del contexto del proceso
  co.com.soaint.bpm.model.domains.TrackDTO trackAux = (co.com.soaint.bpm.model.domains.TrackDTO) kcontext.getVariable("trackDTO");
  
  // Verificar que el objeto no sea nulo antes de acceder a sus propiedades
  if (trackAux != null) {
    int trackStateId = (int) trackAux.getTrackStateId();
    System.out.println("trackAux.trackStateId ----> "+trackStateId);
    if(trackStateId == 22){// aprobado / devuelto
      kcontext.setVariable("nombreTareaProducir","Ajustar documento");
      Integer cantidadRAux = (Integer) kcontext.getVariable("cantidadR");
      kcontext.setVariable("indice", cantidadRAux - 1);
    }
  } 
}

//Asignación de revisor

ArrayList<String> list=(ArrayList) kcontext.getVariable("listaRevisor");
String usuarioDependencia = list.get((int) kcontext.getVariable("indice"));
String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];
kcontext.setVariable("usuarioRevisor", usuario);
kcontext.setVariable("codDependencia", dependencia );
]]></bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:task id="_9530359C-3178-4805-BD54-8413CF4F09E0" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Creacion de registro de tracking">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Creacion de registro de tracking]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("---------- Start at " +
                java.time
                        .LocalTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Script para el revisor ------------");

// ----------- SET ESTADO tracking ---------------------------------------------------------------------------
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();
if(requiereAjuste == 3){//"Reprobado revisor"
	track.setTrackStateId(66);
}else{
  track.setTrackStateId(21);//Revisado
}
//-----------------------------------------------------------------------------------------------------------


//------------------ FLUJO DEVOLUCION INTRA-ETAPA --------------------------------------
// Obtener y convertir las variables a Integer
Integer flagDevolucionAux = kcontext.getVariable("flagDevolucion") != null ? (Integer) kcontext.getVariable("flagDevolucion") : 0;
Integer requiereAjusteAux = kcontext.getVariable("requiereAjuste") != null ? (Integer) kcontext.getVariable("requiereAjuste"): 0;
Integer cantidadRAux = (Integer) kcontext.getVariable("cantidadR");
Integer indiceAux = (Integer) kcontext.getVariable("indice");
String tipoDevolucionAux = (String) kcontext.getVariable("tipoDevolucionAplicada");
kcontext.setVariable("tipoDevolucion", tipoDevolucionAux);

if (requiereAjusteAux == 1 && cantidadRAux > 1 && indiceAux > 0 && "INTRA_ETAPA".equals(tipoDevolucionAux)) {
  kcontext.setVariable("requiereAjuste", 0);
  kcontext.setVariable("flagDevolucion",1);
  track.setTrackStateId(89);//Revisado - devuelto
  kcontext.setVariable("nombreTareaProducir","Ajustar documento");
}/*
else if (requiereAjusteAux == 1 && cantidadRAux > 1 && indiceAux == 0 && "INTRA_ETAPA".equals(tipoDevolucionAux)) {
  track.setTrackStateId(89);//Revisado - devuelto
}*/
else{
  kcontext.setVariable("nombreTareaProducir","Revisar documento");
  kcontext.setVariable("flagDevolucion",0);
}
// --------------------------------------------------------------------------------------

//Creacion de objeto para registro tracking


if(kcontext.getVariable("numeroRadicado")!=null){
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
}else if(kcontext.getVariable("idEcmDocument")!= null){
    track.setObjectId(kcontext.getVariable("idEcmDocument").toString());
}
track.setObjectType("Documento");
if(kcontext.getVariable("nomuser")!=null){
  track.setUser(kcontext.getVariable("nomuser").toString());
}

if(kcontext.getVariable("codDependencia")!=null){
  track.setSubsection(Long.parseLong(kcontext.getVariable("codDependencia").toString()));
}
track.setInstanceId(kcontext.getProcessInstance().getId());

kcontext.setVariable("trackDTO",track);

]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>

    <bpmn2:scriptTask id="_9E1D9657-F77D-489D-8B58-BA56CAAD1AEF" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Inicializar indice" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inicializar indice]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_D01E3FE1-59BF-4FDC-9BC9-F7089BCE4D9F</bpmn2:incoming>
      <bpmn2:outgoing>_93938A6B-D292-40FA-8E63-41602B4FE03D</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("indice",0);

String tipoProduccionAux = (String) kcontext.getVariable("tipoProduccion");
String tipoGeneracion = (String) kcontext.getVariable("generacion");


if(cantidadA == 1 && !"resolucion".equals(tipoProduccionAux) && !"masivo".equals(tipoGeneracion) ){
  kcontext.setVariable("nombreTareaProducir","Aprobar y firmar documento");
}
else{
  kcontext.setVariable("nombreTareaProducir","Aprobar Documento");
}

 ]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_209ACCB7-498D-4ED4-814D-A4E28C3E1A09" drools:selectable="true" drools:dg="" color:background-color="#f0e68c" color:border-color="#a67f00" color:color="#000000" name="Aprobado?" gatewayDirection="Diverging">

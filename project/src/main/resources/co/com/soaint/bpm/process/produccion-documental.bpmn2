    <bpmn2:callActivity id="_A399D7A0-551C-4D13-B349-A7401A47FDF3" drools:selectable="true" drools:independent="true" drools:waitForCompletion="false" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="SubProceso Firma" calledElement="proceso.produccion-firma">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[SubProceso Firma]]></drools:metaValue>

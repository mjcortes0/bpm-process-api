    <bpmn2:callActivity id="_F8F9BB5B-BC87-440B-B08D-B48178FD69FD" drools:selectable="true" drools:independent="true" drools:waitForCompletion="false" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="SubProceso Firma" calledElement="proceso.produccion-firma">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[SubProceso Firma]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("-------------------ENTRO AL SUBPROCESO DE FIRMA-----------------------");

String tipoF = (String) kcontext.getVariable("tipoFirma");

// evita que la tarea de firma se genere cuando se firma y aprueba al tiempo, con excepción de firma manuscrita
if(aprobado == 4 && cantidadA != null && cantidadA == 1 && !"manuscrita".equals(tipoF) ){//"Aprobar y firmar documento"
    kcontext.setVariable("firma","No");
}
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>

    <bpmn2:scriptTask id="_1CF89A57-ADC5-4900-80F4-E045820F7C54" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Incrementar indice" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Incrementar indice]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_806DA6BF-F8A9-496D-A403-0DD3CA84006A</bpmn2:incoming>
      <bpmn2:outgoing>_4A212B3C-EE0F-4927-82D2-2BBC9671E5A9</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("###################################### SCRIPT INCREMENTAR INDICE: " + indice);
//flujo de devolucion
Integer flagDevolucionAux = kcontext.getVariable("flagDevolucion") != null ? (Integer) kcontext.getVariable("flagDevolucion") : 0;
if(flagDevolucionAux == 1){  
  kcontext.setVariable("indice", (int) kcontext.getVariable("indice") - 1);
  kcontext.setVariable("nombreTareaProducir","Ajustar documento");
}
else{
  kcontext.setVariable("indice", (int) kcontext.getVariable("indice") + 1);
  kcontext.setVariable("nombreTareaProducir","Producir Documento");
}

 

ArrayList<String> list= (ArrayList) kcontext.getVariable("listaProyector");
kcontext.setVariable("cantidad", list.size());


]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_A5EA6310-A8BB-4E07-B856-D1CC932F9FB6" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Creacion de registro de tracking">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Creacion de registro de tracking]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[//Inicializar indice en cero
//kcontext.setVariable("nombreTareaProducir","Ajustar Documento");
kcontext.setVariable("indice", 0);

//Bloque para validar si llegó desde la aprobación o revisión INTRA_ETAPA
String tipoDevolucionAux = (String) kcontext.getVariable("tipoDevolucion");

if("INTRA_ETAPA".equals(tipoDevolucionAux) && (aprobado == 0 || requiereAjuste == 1)){
// Recuperar el objeto track del contexto del proceso
  co.com.soaint.bpm.model.domains.TrackDTO trackAux = (co.com.soaint.bpm.model.domains.TrackDTO) kcontext.getVariable("trackDTO");
  
  // Verificar que el objeto no sea nulo antes de acceder a sus propiedades
  if (trackAux != null) {
    int trackStateId = (int) trackAux.getTrackStateId();
    System.out.println("trackAux.trackStateId ----> "+trackStateId);
    if(trackStateId == 21 || trackStateId == 22){// aprobado - devuelto / Revisado - devuelto 
      Integer cantidadAux = (Integer) kcontext.getVariable("cantidad");
      kcontext.setVariable("indice", cantidadAux - 1);
    }
  } 
}

//-----------------------------------------------------------------


//Creacion de objeto para registro tracking
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();

if(kcontext.getVariable("numeroRadicado")!=null){
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
}else if(kcontext.getVariable("idEcmDocument")!= null){
    track.setObjectId(kcontext.getVariable("idEcmDocument").toString());
}

track.setObjectType("Documento");
if(kcontext.getVariable("nomuser")!=null){
  track.setUser(kcontext.getVariable("nomuser").toString());
}

track.setTrackStateId(23);

if(kcontext.getVariable("codDependencia")!=null){
  track.setSubsection(Long.parseLong(kcontext.getVariable("codDependencia").toString()));
}
track.setInstanceId(kcontext.getProcessInstance().getId());

kcontext.setVariable("trackDTO",track);

kcontext.setVariable("idAdobe",null);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[
//Titulo de tarea PROYECTOR

if( (requiereAjuste != null && requiereAjuste == 2) || (aprobado != null && aprobado == 2) ){//"Apartarse"
   kcontext.setVariable("nombreTareaProducir","Apartarse");
}
else if( (requiereAjuste !=null && requiereAjuste == 3) || (aprobado != null && aprobado == 3)){//"Reprobar"
   kcontext.setVariable("nombreTareaProducir","Reprobar");
}
else if( (requiereAjuste !=null && requiereAjuste == 1) || (aprobado != null && aprobado == 0)){//"Devolver"
     kcontext.setVariable("nombreTareaProducir","Ajustar documento");
}
else{
  kcontext.setVariable("nombreTareaProducir","Producir documento");
}


kcontext.setVariable("requiereAjuste", 0);
kcontext.setVariable("aprobado", -1);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

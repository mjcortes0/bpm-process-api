    <bpmn2:task id="_84F1B831-F484-4284-9419-23F2DD5A5377" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Creacion de registro de tracking">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Creacion de registro de tracking]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Start at " +
                java.time
                        .LocalTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Creacion de registro de tracking aprobación");


// ----------- SET ESTADO tracking ---------------------------------------------------------------------------
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();

if(aprobado == 3){//"Reprobado aproabador"
	track.setTrackStateId(67);
}
else if(aprobado == 4 && cantidadA == 1){//"Aprobar y firmar documento"
	track.setTrackStateId(86);
    //kcontext.setVariable("firma","No");// evita que la tarea de firma se genere cuando se fira y aprueba al tiempo
}
else if(aprobado == 2){//"Apartado aprobador"
	track.setTrackStateId(68);
}
else{
    track.setTrackStateId(22);//"Aprobado"
}
//-------------------------------------------------------------------------------------------------------------


//---------------------------------flujos de devolución misma etapa -------------------------------------
// Obtener y convertir las variables a Integer
Integer flagDevolucionAux = kcontext.getVariable("flagDevolucion") != null ? (Integer) kcontext.getVariable("flagDevolucion") : 0;
Integer aprobadoAux = kcontext.getVariable("aprobado") != null ? (Integer) kcontext.getVariable("aprobado"): 0;
Integer cantidadAAux = (Integer) kcontext.getVariable("cantidadA");
Integer indiceAux = (Integer) kcontext.getVariable("indice");
String tipoDevolucionAux = (String) kcontext.getVariable("tipoDevolucionAplicada");
kcontext.setVariable("tipoDevolucion", tipoDevolucionAux);

if (aprobadoAux == 0 && cantidadAAux > 1 && indiceAux > 0 && "INTRA_ETAPA".equals(tipoDevolucionAux)) {
  // Devolver de un aprobador al anterior aprobador
  kcontext.setVariable("aprobado", 1);
  kcontext.setVariable("flagDevolucion",1);
  track.setTrackStateId(90);//Aprobado - devuelto
  kcontext.setVariable("nombreTareaProducir","Ajustar documento");
}
else if (aprobadoAux == 0 && cantidadR > 0 && indiceAux == 0 && "INTRA_ETAPA".equals(tipoDevolucion)) {
  // Devolver del aprobador al revisor
  track.setTrackStateId(90);//Aprobado - devuelto
}
else{
  // Aprobacion
  kcontext.setVariable("flagDevolucion",0);
  kcontext.setVariable("nombreTareaProducir","Aprobar Documento");
}



//-------------------------------------------------------------------------------------------




//Creacion de objeto para registro tracking

if(kcontext.getVariable("numeroRadicado")!=null){
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
}else if(kcontext.getVariable("idEcmDocument")!= null){
    track.setObjectId(kcontext.getVariable("idEcmDocument").toString());
}

track.setObjectType("Documento");
if(kcontext.getVariable("nomuser")!=null){
  track.setUser(kcontext.getVariable("nomuser").toString());
}

if(kcontext.getVariable("codDependencia")!=null){
  track.setSubsection(Long.parseLong(kcontext.getVariable("codDependencia").toString()));
}
track.setInstanceId(kcontext.getProcessInstance().getId());

kcontext.setVariable("trackDTO",track);

]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Ends at " +
                java.time
                        .LocalTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Creacion de registro de tracking");
//Actualizar Lista Aprobadores
ArrayList<String> listA= (ArrayList) kcontext.getVariable("listaAprobador");
kcontext.setVariable("cantidadA", listA.size());  

System.out.println("[lista de aprobador]"+listaAprobador);


// Reinicia indice para Reprobar desde Aprobador hacia el Revisor
if (aprobado == 3 && cantidadR > 0){
  kcontext.setVariable("indice",0);
  kcontext.setVariable("nombreTareaProducir","Reprobar"); //nombre de tare para la tarea Revisar documento
}
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

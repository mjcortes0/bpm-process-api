    <bpmn2:scriptTask id="_430258B5-46D8-4BEF-892E-133AC756C0AB" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Asignar usuario proyector" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Asignar usuario proyector]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_B1463D35-4AB3-482A-ABF3-02E1063084CE</bpmn2:incoming>
      <bpmn2:outgoing>_ECD81F46-43C8-41F2-A1F2-72E16EBC945A</bpmn2:outgoing>
      <bpmn2:script><![CDATA[ArrayList<String> list=(ArrayList) kcontext.getVariable("listaProyector");
String usuarioDependencia = list.get((int) kcontext.getVariable("indice"));

String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];

kcontext.setVariable("usuarioProyector", usuario);
kcontext.setVariable("codDependencia", dependencia );

]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:startEvent id="_F645FE6A-C643-4310-B48D-1B9EA7F74E3A" drools:selectable="true" color:background-color="#9acd32" color:border-color="#000000" color:color="#000000" name="Iniciar">

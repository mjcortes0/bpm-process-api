    <bpmn2:task id="_F59FC7F7-459E-44FA-8671-7EF8DFA89627" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Alerta Electronica">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Alerta Electronica]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Entrando al MyCustomhamdler 1 {} {} {} {} ");
//Script Task Correo
System.out.println("Iniciando Script de variables para alerta alectronica produccion documental con proyectores");
java.util.Map <String, Object> params2 = new java.util.HashMap<>();

params2.put("numeroRadicado", kcontext.getVariable("numeroRadicado"));
params2.put("listaProyector", kcontext.getVariable("listaProyector"));
params2.put("Term", kcontext.getVariable("preAlerta"));

co.com.soaint.bpm.model.domains.MailDTO request = new co.com.soaint.bpm.model.domains.MailDTO();
request.setParams(params2);
kcontext.setVariable("mailDTO",  request);
System.out.println("Terminando Script de variables para alerta alectronica produccion documental con proyectores");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[
mailDTO.getParams().replace("Term", "alerta");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>

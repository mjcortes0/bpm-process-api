    <bpmn2:scriptTask id="_5B42C81A-515A-47DA-AD80-19496AA17BB5" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Asignar aprobador" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Asignar aprobador]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CB567993-53DE-48A7-9F3B-3E3455F0D082</bpmn2:incoming>
      <bpmn2:outgoing>_4662436B-E969-4281-BDEC-54C8AF60B88D</bpmn2:outgoing>
      <bpmn2:script><![CDATA[ArrayList<String> list=(ArrayList) kcontext.getVariable("listaAprobador");
kcontext.setVariable("usuarioAprobador", list.get((int) kcontext.getVariable("indice")));
String usuarioDependencia = list.get((int) kcontext.getVariable("indice"));
String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];
kcontext.setVariable("usuarioAprobador", usuario);
kcontext.setVariable("codDependencia", dependencia );
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_0EBAA650-2BE1-4775-ADD1-4D225A4D9632" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Consulta Vencimiento">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Consulta Vencimiento]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[kcontext.setVariable("bandConsultaFechas","si");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[//Set Vencimientos
System.out.println("Respuesta Map {} {} {} {} {} " + kcontext.getVariable("respuestaMap"));


java.util.HashMap map = (java.util.HashMap) kcontext.getVariable("respuestaMap");

if(map.get("fecVenGestion") != null && map.get("preFecVenGestion") != null){ 
  kcontext.setVariable("fechaVencimiento", map.get("fecVenGestion").toString());
  kcontext.setVariable("preAlerta", map.get("preFecVenGestion").toString());
}else{
  kcontext.setVariable("fechaVencimiento", "1");
  kcontext.setVariable("preAlerta", "1");
}

System.out.println(kcontext.getVariable("fechaVencimiento"));
System.out.println(kcontext.getVariable("preAlerta"));
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
